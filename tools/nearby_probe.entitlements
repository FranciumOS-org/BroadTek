<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- One group only. The question is whether a Rapport same-account
         identity key produces the NearbyInfo auth tag that macOS matches the
         iPhone by; nothing outside com.apple.rapport is needed to ask it. -->
    <key>keychain-access-groups</key>
    <array>
        <string>com.apple.rapport</string>
    </array>
</dict>
</plist>
