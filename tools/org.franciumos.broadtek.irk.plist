<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installs the peer IRK into BroadTek after every boot.
     The key lives only in kernel memory, deliberately, so it has to be put
     there again each time. A daemon rather than an agent because the kext
     accepts a key only from root; the wrapper then runs the helper inside the
     logged-in user's session, because the keychain cannot be read outside one. Its log only ever holds addresses and
     statuses: the key is never printed. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.franciumos.broadtek.irk</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/broadtek-irk-session</string>
        <string>--wait</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- It exits as soon as a key is in, and gives up after five minutes.
         It runs again every five minutes as well: installing the same key again
         changes nothing, and it puts the key back if anything has lost it. -->
    <key>KeepAlive</key>
    <false/>
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/var/log/broadtek-irk.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/broadtek-irk.log</string>
</dict>
</plist>
